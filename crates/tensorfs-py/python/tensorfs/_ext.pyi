@final
class Writer:
    def __new__(cls, dest: StrPath | None = None, *, base: Checkpoint | None = None,
                 resume: str | None = None, cache_dir: StrPath | None = None,
                 model_id: str | None = None, lane: str | None = None,
                 repo_id: str | None = None, endpoint: str | None = None, token: _Token | None = None, ca_der: bytes | None = None) -> Writer: ...
    def pipeline(self, cls: ClassRef | tuple[str, str, str] | Literal[""] | None, config: Mapping[str, ConfigInput]) -> None: ...
    def component(
        self, name: str, cls: ClassRef | tuple[str, str, str] | Literal[""] | None = None, config: Mapping[str, ConfigInput] | None = None,
        config_file: str | None = None,
    ) -> ComponentWriter:
        """Declares a component (again: class and config change, tensors stay)."""
    def set_metadata(self, key: str, value: MetadataInput) -> None: ...
    def has(self, component: str, key: str) -> bool: ...
    def normalize_bf16(self, source: Checkpoint, tensors: Sequence[NormalizeBf16Tensor], *,
                      max_buffer_bytes: int, max_new_bytes: int,
                      control: ConversionControl) -> NormalizationResult: ...
    def quantize(self, source: Checkpoint, tensors: Sequence[QuantizeTensor], *,
                 max_buffer_bytes: int, max_new_bytes: int, control: ConversionControl,
                 max_relative_frobenius: float | None = None,
                 calibration: Checkpoint | None = None,
                 component: str | None = None) -> QuantizationResult: ...
    def commit(self) -> Checkpoint: ...
    def abandon(self) -> None: ...

