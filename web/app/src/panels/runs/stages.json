{
  "version": 1,
  "phases": ["placing", "renting", "queued", "uploading", "installing", "downloading", "preparing", "importing", "starting", "loading", "compiling", "working", "saving", "result"],
  "stages": [
    { "match": "denoise", "says": "Rendering", "phase": "working", "counts": "step" },
    { "match": "generating image", "says": "Rendering the image", "phase": "working", "counts": "step" },
    { "match": "generate", "says": "Rendering the image", "phase": "working", "counts": "step" },
    { "match": "refine", "says": "Refining", "phase": "working", "counts": "step" },

    { "match": "answering", "says": "Writing", "phase": "working", "counts": "token" },
    { "match": "reading", "says": "Reading the inputs", "phase": "working" },
    { "match": "upsampling prompt", "says": "Rewriting the prompt", "phase": "working", "counts": "token" },
    { "match": "thinking", "says": "Thinking", "phase": "working", "counts": "token" },
    { "match": "encoding prompt", "says": "Reading the prompt", "phase": "working" },
    { "match": "tokenize", "says": "Reading the prompt", "phase": "working" },
    { "match": "encoding reference images", "says": "Reading the reference images", "phase": "working" },
    { "match": "encoding pictures", "says": "Reading the images", "phase": "working" },
    { "match": "decoding image", "says": "Decoding the image", "phase": "working" },
    { "match": "render", "says": "Rendering", "phase": "working" },
    { "match": "conditioning", "says": "Reading the inputs", "phase": "working" },
    { "match": "decoding", "says": "Decoding the image", "phase": "working" },
    { "match": "saving image", "says": "Saving the image", "phase": "saving" },
    { "match": "picking size", "says": "Picking the size", "phase": "working" },
    { "match": "reading picture", "says": "Reading the image", "phase": "working" },
    { "match": "reading reference", "says": "Reading the reference", "phase": "working" },
    { "match": "removing background", "says": "Removing the background", "phase": "working" },
    { "match": "saving character reference", "says": "Saving the character reference", "phase": "saving" },
    { "match": "saving picture", "says": "Saving the image", "phase": "saving" },
    { "match": "encode_webp", "says": "Saving the image", "phase": "saving" },

    { "match": "prepare", "says": "Preparing", "phase": "working" },
    { "match": "condition", "says": "Reading the inputs", "phase": "working" },
    { "match": "condition_text", "says": "Reading the prompt", "phase": "working" },
    { "match": "condition_media", "says": "Reading the images", "phase": "working" },
    { "match": "read_video", "says": "Reading the video", "phase": "working" },
    { "match": "upscale_latent", "says": "Upscaling", "phase": "working" },
    { "match": "decode_video", "says": "Decoding the video", "phase": "working", "counts": "frame" },
    { "match": "encode_video", "says": "Saving the video", "phase": "saving", "counts": "frame" },
    { "match": "decode_audio", "says": "Decoding the audio", "phase": "working" },
    { "match": "timestep-table-{what}", "says": "Preparing {what}", "phase": "preparing", "counts": "item" },
    { "match": "cast-{what}", "says": "Preparing {what}", "phase": "preparing", "counts": "item" },
    { "match": "regenerate-{what}", "says": "Preparing {what}", "phase": "preparing", "counts": "item" },
    { "match": "turbo-{what}", "says": "Preparing turbo {what}", "phase": "preparing", "counts": "item" },
    { "match": "{what}-copy", "says": "Copying {what}", "phase": "preparing", "counts": "item" },
    { "match": "adaln tables", "says": "Preparing the model", "phase": "preparing", "counts": "item" },
    { "match": "copying", "says": "Copying the weights", "phase": "preparing", "counts": "item" },
    { "match": "copying edited tensors", "says": "Copying the edited weights", "phase": "preparing", "counts": "item" },

    { "match": "upscaling frames", "says": "Upscaling the frames", "phase": "working", "counts": "frame" },
    { "match": "seedvr2 vae encode", "says": "Reading the video", "phase": "working" },
    { "match": "seedvr2 denoise", "says": "Restoring the video", "phase": "working" },
    { "match": "seedvr2 vae decode", "says": "Decoding the video", "phase": "working" },
    { "match": "restoring {what}", "says": "Restoring {what}", "phase": "working" },
    { "match": "writing the turn", "says": "Saving the reply", "phase": "saving" },
    { "match": "calibrating", "says": "Calibrating", "phase": "working", "counts": "item" },
    { "match": "vae operands", "says": "Preparing the decoder", "phase": "loading", "counts": "item" },
    { "match": "measure", "says": "Measuring", "phase": "working" },
    { "match": "idle graph capture", "says": "Optimizing while idle", "phase": "working" },
    { "match": "idle host page pin", "says": "Optimizing memory while idle", "phase": "working" },
    { "match": "native quantization", "says": "Quantizing the weights", "phase": "working" },
    { "match": "bf16", "says": "Converting the weights to BF16", "phase": "working" },
    { "match": "fp8.rowwise-{component}", "says": "Quantizing {component} to FP8", "phase": "working" },
    { "match": "nvfp4-{component}", "says": "Quantizing {component} to NVFP4", "phase": "working" },

    { "match": "loading the models", "says": "Loading the models", "phase": "loading" },
    { "match": "loading {what}", "says": "Loading the model", "phase": "loading", "counts": "bytes" },
    { "match": "compiling {what}", "says": "Optimizing for this GPU", "phase": "compiling", "counts": "item" },
    { "match": "copying {set} kernels", "says": "Optimizing for this GPU", "phase": "compiling" },
    { "match": "capturing graphs", "says": "Optimizing for this GPU", "phase": "compiling", "counts": "item" },
    { "match": "checking {kernel}", "says": "Optimizing for this GPU", "phase": "compiling", "counts": "item" },
    { "match": "opening {kernel}", "says": "Starting up", "phase": "starting" },
    { "match": "constructing {model}", "says": "Setting up {model}", "phase": "loading" },
    { "match": "starting the gpu", "says": "Starting the GPU", "phase": "starting" },
    { "match": "starting the group's gpus", "says": "Starting the GPUs", "phase": "starting" },
    { "match": "measuring the links between gpus", "says": "Testing the connections between GPUs", "phase": "starting" },
    { "match": "joining the group's gpus", "says": "Connecting the GPUs", "phase": "starting" },
    { "match": "warming {package}", "says": "Warming up {package}", "phase": "loading" },
    { "match": "encoding the outputs", "says": "Saving the results", "phase": "saving" },
    { "match": "saving the outputs", "says": "Saving the results", "phase": "saving" },
    { "match": "waiting for {kernel} compile", "says": "Waiting for the GPU optimization to finish", "phase": "compiling" },
    { "match": "forming the group: {what}", "says": "Connecting the GPUs: {what}", "phase": "starting" },
    { "match": "waiting on gpu {#n}: hello", "says": "Starting GPU {n}", "phase": "starting" },
    { "match": "waiting on gpu {#n}: start", "says": "Starting GPU {n}", "phase": "starting" },
    { "match": "waiting on gpu {#n}: join", "says": "Connecting GPU {n}", "phase": "starting" },
    { "match": "waiting on gpu {#n}: form", "says": "Connecting GPU {n}", "phase": "starting" },
    { "match": "waiting on gpu {#n}: load", "says": "GPU {n} is loading the model", "phase": "loading" },
    { "match": "waiting on gpu {#n}: attention", "says": "Optimizing GPU {n}", "phase": "starting" },
    { "match": "waiting on gpu {#n}: kernels", "says": "Optimizing GPU {n}", "phase": "starting" },
    { "match": "waiting on gpu {#n}: {what}", "says": "Waiting for GPU {n}: {what}", "phase": "starting" },
    { "match": "waiting for the models to download: {what}", "says": "Waiting for the models to download: {what}", "phase": "downloading" },
    { "match": "waiting for the models to download", "says": "Waiting for the models to download", "phase": "downloading" },
    { "match": "waiting for {gpus}: {what}", "says": "Waiting for {gpus}: {what}", "phase": "working" },
    { "match": "installing cpython {version}", "says": "Installing Python {version}", "phase": "installing" },
    { "match": "cpython {version} ready", "says": "Python {version} ready", "phase": "installing" },

    { "match": "preparing", "says": "Preparing", "phase": "preparing" },
    { "match": "waiting", "says": "Waiting", "phase": "queued" },
    { "match": "installing", "says": "Installing", "phase": "installing" },
    { "match": "waiting_activation", "says": "Finishing the update", "phase": "installing" },
    { "match": "starting", "says": "Starting", "phase": "starting" },
    { "match": "preparing the plan", "says": "Planning the run", "phase": "preparing" },
    { "match": "installing this machine's pytorch", "says": "Installing PyTorch", "phase": "installing" },
    { "match": "installing {what}", "says": "Installing {what}", "phase": "installing" },
    { "match": "updating {what}", "says": "Updating {what}", "phase": "installing" },
    { "match": "describing {what}", "says": "Reading {what}", "phase": "installing" },
    { "match": "choosing the model for {slot}", "says": "Choosing the model for {slot}", "phase": "preparing" },
    { "match": "resolving", "says": "Finding the model", "phase": "preparing" },
    { "match": "downloading", "says": "Downloading the model", "phase": "downloading", "counts": "bytes" },
    { "match": "reading headers", "says": "Reading the files", "phase": "importing", "counts": "item" },
    { "match": "checking its family", "says": "Checking the model", "phase": "importing" },
    { "match": "converting", "says": "Converting the weights", "phase": "importing", "counts": "item" },
    { "match": "imported", "says": "Imported the model", "phase": "importing" },
    { "match": "committing", "says": "Saving the model", "phase": "importing", "counts": "bytes" },
    { "match": "resolving for {slot}", "says": "Finding the model for {slot}", "phase": "preparing" },
    { "match": "resolving {models}", "says": "Finding {models}", "phase": "preparing" },
    { "match": "downloading for {slot}", "says": "Downloading the model for {slot}", "phase": "downloading", "counts": "bytes" },
    { "match": "downloading the result", "says": "Downloading the result", "phase": "result", "counts": "bytes" },
    { "match": "downloading {models} weights", "says": "Downloading {models}", "phase": "downloading", "counts": "bytes" },
    { "match": "waiting for {models} to download", "says": "Waiting for {models} to download", "phase": "downloading" },
    { "match": "reading headers for {slot}", "says": "Reading the files for {slot}", "phase": "importing", "counts": "item" },
    { "match": "checking its family for {slot}", "says": "Checking the model for {slot}", "phase": "importing" },
    { "match": "family: {what}", "says": "Model family: {what}", "phase": "importing" },
    { "match": "converting for {slot}", "says": "Converting the weights for {slot}", "phase": "importing", "counts": "item" },
    { "match": "imported for {slot}", "says": "Imported the model for {slot}", "phase": "importing" },
    { "match": "committing for {slot}", "says": "Saving the model for {slot}", "phase": "importing", "counts": "bytes" },
    { "match": "detected {what} for {slot}", "says": "Found {what} for {slot}", "phase": "importing" },
    { "match": "preparing the plan for {package}", "says": "Planning {package}", "phase": "preparing" },
    { "match": "preparing model adapters for {slot}", "says": "Preparing the LoRAs for {slot}", "phase": "preparing" },
    { "match": "preparing {package}", "says": "Preparing {package}", "phase": "preparing" },
    { "match": "composing", "says": "Putting it together", "phase": "preparing" },
    { "match": "importing it", "says": "Loading the package", "phase": "importing" },
    { "match": "importing {package}", "says": "Loading {package}", "phase": "importing" },
    { "match": "starting the executor", "says": "Starting up", "phase": "starting" },
    { "match": "warming", "says": "Warming up", "phase": "loading" },
    { "match": "warning: {what}", "says": "Warning: {what}", "phase": "preparing" },
    { "match": "{what}-{component}", "says": "Preparing {component}", "phase": "preparing", "counts": "item" },

    { "match": "segment {#k} of {#n}", "says": "Segment {k} of {n}", "scope": true },
    { "match": "regenerate at {what}", "says": "Regenerating from {what}", "scope": true },
    { "match": "turn", "says": "Turn", "scope": true },
    { "match": "loop join", "says": "Joining the loop", "scope": true },
    { "match": "{part} {#k} of {#n}", "says": "{part} {k} of {n}", "scope": true }
  ]
}
