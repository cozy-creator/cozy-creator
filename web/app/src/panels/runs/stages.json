{
  "version": 1,
  "phases": ["placing", "renting", "queued", "uploading", "installing", "downloading", "preparing", "importing", "starting", "loading", "compiling", "working", "saving", "result"],
  "stages": [
    { "match": "denoise", "says": "Denoising", "phase": "working", "counts": "step" },
    { "match": "generating image", "says": "Generating the image", "phase": "working", "counts": "step" },
    { "match": "generate", "says": "Generating the image", "phase": "working", "counts": "step" },
    { "match": "refine", "says": "Refining", "phase": "working", "counts": "step" },

    { "match": "answering", "says": "Answering", "phase": "working", "counts": "token" },
    { "match": "reading", "says": "Reading the inputs", "phase": "working" },
    { "match": "upsampling prompt", "says": "Rewriting the prompt", "phase": "working", "counts": "token" },
    { "match": "thinking", "says": "Thinking", "phase": "working", "counts": "token" },
    { "match": "encoding prompt", "says": "Encoding the prompt", "phase": "working" },
    { "match": "tokenize", "says": "Reading the prompt", "phase": "working" },
    { "match": "encoding reference images", "says": "Encoding the pictures", "phase": "working" },
    { "match": "encoding pictures", "says": "Encoding the pictures", "phase": "working" },
    { "match": "decoding image", "says": "Decoding the image", "phase": "working" },
    { "match": "conditioning", "says": "Encoding the inputs", "phase": "working" },
    { "match": "decoding", "says": "Decoding the image", "phase": "working" },
    { "match": "saving image", "says": "Saving the image", "phase": "saving" },
    { "match": "encode_webp", "says": "Saving the image", "phase": "saving" },

    { "match": "prepare", "says": "Preparing the shot", "phase": "working" },
    { "match": "condition", "says": "Encoding the inputs", "phase": "working" },
    { "match": "condition_text", "says": "Encoding the prompt", "phase": "working" },
    { "match": "condition_media", "says": "Encoding the pictures", "phase": "working" },
    { "match": "read_video", "says": "Reading the video", "phase": "working" },
    { "match": "upscale_latent", "says": "Upscaling the latents", "phase": "working" },
    { "match": "decode_video", "says": "Decoding video", "phase": "working", "counts": "frame" },
    { "match": "encode_video", "says": "Encoding video", "phase": "saving", "counts": "frame" },
    { "match": "decode_audio", "says": "Decoding audio", "phase": "working" },
    { "match": "timestep-table-{what}", "says": "Building the timestep table {what}", "phase": "preparing", "counts": "item" },
    { "match": "cast-{what}", "says": "Casting {what}", "phase": "preparing", "counts": "item" },
    { "match": "regenerate-{what}", "says": "Preparing to regenerate {what}", "phase": "preparing", "counts": "item" },
    { "match": "turbo-{what}", "says": "Preparing turbo {what}", "phase": "preparing", "counts": "item" },
    { "match": "{what}-copy", "says": "Copying {what}", "phase": "preparing", "counts": "item" },

    { "match": "upscaling frames", "says": "Upscaling frames", "phase": "working", "counts": "frame" },
    { "match": "seedvr2 vae encode", "says": "Encoding the video", "phase": "working" },
    { "match": "seedvr2 denoise", "says": "Restoring the video", "phase": "working" },
    { "match": "seedvr2 vae decode", "says": "Decoding the video", "phase": "working" },
    { "match": "restoring {what}", "says": "Restoring {what}", "phase": "working" },
    { "match": "writing the turn", "says": "Writing the turn", "phase": "saving" },
    { "match": "calibrating", "says": "Calibrating", "phase": "working", "counts": "item" },
    { "match": "vae operands", "says": "Preparing the decoder", "phase": "loading", "counts": "item" },
    { "match": "measure", "says": "Measuring", "phase": "working" },
    { "match": "idle graph capture", "says": "Capturing graphs while idle", "phase": "working" },
    { "match": "idle host page pin", "says": "Pinning memory while idle", "phase": "working" },
    { "match": "native quantization", "says": "Quantizing the weights", "phase": "working" },
    { "match": "bf16", "says": "Converting the weights to BF16", "phase": "working" },
    { "match": "fp8.rowwise-{component}", "says": "Quantizing {component} to FP8", "phase": "working" },
    { "match": "nvfp4-{component}", "says": "Quantizing {component} to NVFP4", "phase": "working" },

    { "match": "loading {what}", "says": "Loading {what}", "phase": "loading", "counts": "bytes" },
    { "match": "compiling {what}", "says": "Compiling {what}", "phase": "compiling" },
    { "match": "waiting for {kernel} compile", "says": "Waiting for {kernel} to compile", "phase": "compiling" },
    { "match": "forming the group: {what}", "says": "Forming the GPU group: {what}", "phase": "starting" },
    { "match": "waiting on gpu {#n}: hello", "says": "Starting GPU {n}", "phase": "starting" },
    { "match": "waiting on gpu {#n}: start", "says": "Starting GPU {n}", "phase": "starting" },
    { "match": "waiting on gpu {#n}: join", "says": "GPU {n} joining the group", "phase": "starting" },
    { "match": "waiting on gpu {#n}: form", "says": "GPU {n} forming the group", "phase": "starting" },
    { "match": "waiting on gpu {#n}: load", "says": "GPU {n} loading its models", "phase": "loading" },
    { "match": "waiting on gpu {#n}: attention", "says": "GPU {n} choosing its attention kernels", "phase": "starting" },
    { "match": "waiting on gpu {#n}: kernels", "says": "GPU {n} loading its kernels", "phase": "starting" },
    { "match": "waiting on gpu {#n}: {what}", "says": "Waiting on GPU {n}: {what}", "phase": "starting" },
    { "match": "waiting for {gpus}: {what}", "says": "Waiting for {gpus}: {what}", "phase": "working" },
    { "match": "installing cpython {version}", "says": "Installing Python {version}", "phase": "installing" },
    { "match": "cpython {version} ready", "says": "Python {version} ready", "phase": "installing" },

    { "match": "preparing", "says": "Preparing", "phase": "preparing" },
    { "match": "installing this machine's pytorch", "says": "Installing this machine's PyTorch", "phase": "installing" },
    { "match": "installing {what}", "says": "Installing {what}", "phase": "installing" },
    { "match": "updating {what}", "says": "Updating {what}", "phase": "installing" },
    { "match": "describing {what}", "says": "Reading {what}'s functions", "phase": "installing" },
    { "match": "choosing the model for {slot}", "says": "Choosing the model for {slot}", "phase": "preparing" },
    { "match": "resolving for {slot}", "says": "Finding the source for {slot}", "phase": "preparing" },
    { "match": "resolving {models}", "says": "Finding {models}", "phase": "preparing" },
    { "match": "downloading for {slot}", "says": "Downloading the source for {slot}", "phase": "downloading", "counts": "bytes" },
    { "match": "downloading the result", "says": "Downloading the result", "phase": "result", "counts": "bytes" },
    { "match": "downloading {models} weights", "says": "Downloading {models} weights", "phase": "downloading", "counts": "bytes" },
    { "match": "reading headers for {slot}", "says": "Reading the files for {slot}", "phase": "importing", "counts": "item" },
    { "match": "checking its family for {slot}", "says": "Checking the model for {slot}", "phase": "importing" },
    { "match": "family: {what}", "says": "Model family: {what}", "phase": "importing" },
    { "match": "converting for {slot}", "says": "Converting the weights for {slot}", "phase": "importing", "counts": "item" },
    { "match": "imported for {slot}", "says": "Imported the weights for {slot}", "phase": "importing" },
    { "match": "committing for {slot}", "says": "Saving the weights for {slot}", "phase": "importing", "counts": "bytes" },
    { "match": "detected {what} for {slot}", "says": "Read {slot}: {what}", "phase": "importing" },
    { "match": "preparing the plan for {package}", "says": "Preparing the plan for {package}", "phase": "preparing" },
    { "match": "preparing model adapters for {slot}", "says": "Preparing the adapters for {slot}", "phase": "preparing" },
    { "match": "preparing {package}", "says": "Preparing {package}", "phase": "preparing" },
    { "match": "composing", "says": "Composing", "phase": "preparing" },
    { "match": "importing it", "says": "Importing the package", "phase": "importing" },
    { "match": "importing {package}", "says": "Importing {package}", "phase": "importing" },
    { "match": "starting the executor", "says": "Starting the executor", "phase": "starting" },
    { "match": "warming", "says": "Warming", "phase": "loading" },
    { "match": "warning: {what}", "says": "Warning: {what}", "phase": "preparing" },

    { "match": "segment {#k} of {#n}", "says": "Segment {k} of {n}", "scope": true },
    { "match": "regenerate at {what}", "says": "Regenerating at {what}", "scope": true },
    { "match": "turn", "says": "Turn", "scope": true },
    { "match": "loop join", "says": "Joining the loop", "scope": true },
    { "match": "{part} {#k} of {#n}", "says": "{part} {k} of {n}", "scope": true }
  ]
}
