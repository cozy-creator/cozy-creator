# The parts of nvidia-ml-py (no types of its own) that release-gate/suites/varena/torch-offload/ci_torch_offload/sdxl.py calls.
class c_nvmlDevice_t: ...

class c_nvmlMemory_t:
    total: int
    free: int
    used: int

def nvmlInit() -> None: ...
def nvmlDeviceGetHandleByIndex(index: int) -> c_nvmlDevice_t: ...
def nvmlDeviceGetMemoryInfo(handle: c_nvmlDevice_t) -> c_nvmlMemory_t: ...
